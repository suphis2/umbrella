[ req ]
default_bits       = 2048
prompt             = no
default_md         = sha256
req_extensions     = req_ext
distinguished_name = dn

[ dn ]
C  = NL
ST = Noord-Holland
L  = Amsterdam
O  = LAMP Kubernetes Demo
OU = Education
CN = apache.local

[ req_ext ]
subjectAltName = @alt_names

[ alt_names ]
DNS.1 = apache.local
DNS.2 = php.local
``
